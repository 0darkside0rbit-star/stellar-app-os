// Prisma schema for the Stellar Farm Credit application.
//
// NOTE: This schema documents the data model in Prisma format per the
// sponsor-map feature request. The production app uses raw SQL migrations
// under db/migrations/ with the `pg` driver (see lib/db/client.ts).
// To keep both in sync, mirror any model change here into a new SQL
// migration file (e.g. db/migrations/NNN_description.sql).
//
// Usage (if you later switch the app to Prisma ORM):
//   npx prisma generate
//   npx prisma migrate dev --name <description>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── PlantingLocation ─────────────────────────────────────────────────────────
//
// Browseable, filterable tree-planting sites displayed on the sponsor map.
//
// Required environment for this model:
//   DATABASE_URL — standard PostgreSQL connection string

model PlantingLocation {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(200)
  description       String    @db.Text
  latitude          Float     @db.DoublePrecision
  longitude         Float     @db.DoublePrecision
  region            String    @db.VarChar(100) // e.g. "North America", "Sub-Saharan Africa"
  climate           String    @db.VarChar(50)  // e.g. "Tropical", "Arid", "Temperate"
  species           String[]                     // PostgreSQL TEXT[] — slugs matching species_catalogue.slug
  availableCapacity Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Optional: if you later relate this to existing DB tables, uncomment:
  // trees             Tree[]

  @@index([region])
  @@index([climate])
  @@index([latitude, longitude])
  @@map("planting_locations")
}

// Carbon methodology library (migration 025). Reference catalogue of calculation
// methodologies; seeded from data/carbon-methodologies/*.json.
model CarbonMethodology {
  slug             String   @id
  code             String
  name             String
  category         String   // reforestation | soil_sequestration | renewable_energy | methane_reduction | energy_efficiency
  standard         String
  version          String?
  description      String   @db.Text
  formula          String   @db.Text
  parameters       Json     @default("[]")
  applicability    String[]
  sourceRef        String   @map("source_ref") @db.Text
  metadataVerified Boolean  @default(false) @map("metadata_verified")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("carbon_methodologies")
  @@index([category])
  @@index([standard])
}

// ── ProjectRiskScore ────────────────────────────────────────────────────────
//
// Buyer risk scores for carbon credit projects (Issue #1294).
// Calculated from verifier reputation, methodology strength, regional stability,
// and farmer track record. Persisted for auditability and caching.
//
// Schema is for documentation; production uses raw SQL migrations (see note above).
model ProjectRiskScore {
  id                          String   @id @default(cuid())
  projectId                   String   @unique
  overallScore                Int      // 0-100
  riskRating                  String   // 'Low' | 'Medium' | 'High'
  verifierReputationScore     Int      // 0-100
  methodologyStrengthScore    Int      // 0-100
  regionalStabilityScore      Int      // 0-100
  farmerTrackRecordScore      Int      // 0-100
  
  // Data gap documentation (for transparency)
  dataGaps                    String[]
  
  // Metadata
  calculatedAt                DateTime @default(now()) @map("calculated_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([riskRating])
  @@index([updatedAt])
  @@map("project_risk_scores")
}

// ── BulkPurchaseAgreement ───────────────────────────────────────────────────
//
// Negotiated bulk purchase agreements between corporate buyers and farmers
// for large-volume (100+ ton) batches at discounted rates (Issue: buyer bulk
// purchasing - volume discounts v1).
//
// Schema is for documentation; production uses raw SQL migrations (see note above).
model BulkPurchaseAgreement {
  id                  String   @id @default(cuid())
  buyerId             String   @map("buyer_id")
  farmerId            String   @map("farmer_id")
  commodity           String   @db.VarChar(100)
  quantityTons        Float    @map("quantity_tons") @db.DoublePrecision
  basePricePerTon     Float    @map("base_price_per_ton") @db.DoublePrecision
  discountPercent     Float    @map("discount_percent") @db.DoublePrecision
  negotiatedPricePerTon Float  @map("negotiated_price_per_ton") @db.DoublePrecision
  totalValue          Float    @map("total_value") @db.DoublePrecision
  currency            String   @default("USD") @db.VarChar(3)
  status              String   @default("draft") @db.VarChar(20) // draft | active | fulfilled | cancelled | expired
  deliveryStartDate   DateTime? @map("delivery_start_date")
  deliveryEndDate     DateTime? @map("delivery_end_date")
  terms               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([buyerId])
  @@index([farmerId])
  @@index([status])
  @@index([commodity])
  @@map("bulk_purchase_agreements")
}

// ── BulkPurchaseTier ────────────────────────────────────────────────────────
//
// Volume discount tiers applied to bulk purchase agreements. Each tier defines
// a minimum quantity threshold and the discount percentage granted at or above
// that threshold. Tiers are evaluated in ascending order of minQuantityTons.
model BulkPurchaseTier {
  id                String   @id @default(cuid())
  agreementId       String   @map("agreement_id")
  minQuantityTons   Float    @map("min_quantity_tons") @db.DoublePrecision
  discountPercent   Float    @map("discount_percent") @db.DoublePrecision
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([agreementId])
  @@index([minQuantityTons])
  @@map("bulk_purchase_tiers")
}

// ── BulkPurchaseOrder ───────────────────────────────────────────────────────
//
// Individual orders drawn against a bulk purchase agreement. Each order
// consumes a portion of the agreement's quantity and records the applied
// volume discount tier.
model BulkPurchaseOrder {
  id                String   @id @default(cuid())
  agreementId       String   @map("agreement_id")
  quantityTons      Float    @map("quantity_tons") @db.DoublePrecision
  appliedTierId     String?  @map("applied_tier_id")
  discountPercent   Float    @map("discount_percent") @db.DoublePrecision
  pricePerTon       Float    @map("price_per_ton") @db.DoublePrecision
  totalValue        Float    @map("total_value") @db.DoublePrecision
  status            String   @default("pending") @db.VarChar(20) // pending | confirmed | delivered | cancelled
  orderedAt         DateTime @default(now()) @map("ordered_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([agreementId])
  @@index([status])
  @@index([orderedAt])
  @@map("bulk_purchase_orders")
}

// ── Newsletter ──────────────────────────────────────────────────────────────
//
// Curated monthly forest health newsletter managed from the admin panel
// (Issue #1703). Content is composed of sections (platform news, featured
// reforestation stories, species spotlights, conservation tips) and is sent
// to sponsors who have opted in via their notification preferences.
//
// Schema is for documentation; production uses raw SQL migrations (see note above).
model Newsletter {
  id              String    @id @default(cuid())
  title           String    @db.VarChar(200)
  slug            String    @unique @db.VarChar(200)
  summary         String?   @db.Text
  status          String    @default("draft") @db.VarChar(20) // draft | scheduled | sent | archived
  sections        Json      @default("[]") // ordered array of { type, title, body, ... }
  scheduledFor    DateTime? @map("scheduled_for")
  sentAt          DateTime? @map("sent_at")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  subscriptions   NewsletterSubscription[]

  @@index([status])
  @@index([scheduledFor])
  @@map("newsletters")
}

// ── NewsletterSubscription ──────────────────────────────────────────────────
//
// Per-sponsor opt-in/out state for the monthly newsletter (Issue #1703).
// The personalised section of each issue is built from the subscriber's own
// tree updates, so the row is keyed by sponsor identity.
model NewsletterSubscription {
  id              String    @id @default(cuid())
  newsletterId    String?   @map("newsletter_id")
  sponsorId       String    @map("sponsor_id")
  email           String    @db.VarChar(320)
  optedIn         Boolean   @default(true) @map("opted_in")
  includeTreeUpdates Boolean @default(true) @map("include_tree_updates")
  unsubscribedAt  DateTime? @map("unsubscribed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  newsletter      Newsletter? @relation(fields: [newsletterId], references: [id], onDelete: SetNull)

  @@unique([newsletterId, sponsorId])
  @@index([sponsorId])
  @@index([optedIn])
  @@map("newsletter_subscriptions")
}

// ── SeedBank ────────────────────────────────────────────────────────────────
//
// Partner-organisation seed bank holding native plant seed lots
// (Issue #1709). Inventory dashboards aggregate SeedBatch rows per bank.
//
// Schema is for documentation; production uses raw SQL migrations (see note above).
model SeedBank {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(200)
  organisation    String    @db.VarChar(200)
  region          String    @db.VarChar(100)
  latitude        Float?    @db.DoublePrecision
  longitude       Float?    @db.DoublePrecision
  contactEmail    String?   @map("contact_email") @db.VarChar(320)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  batches         SeedBatch[]

  @@index([region])
  @@map("seed_banks")
}

// ── SeedBatch ───────────────────────────────────────────────────────────────
//
// A tracked lot of native plant seed from collection through storage and
// distribution to planting sites (Issue #1709). Provenance fields record
// where and when the seed was collected so it can be linked to each tree.
model SeedBatch {
  id                String    @id @default(cuid())
  batchCode         String    @unique @map("batch_code") @db.VarChar(100)
  seedBankId        String    @map("seed_bank_id")
  speciesSlug       String    @map("species_slug") @db.VarChar(200) // matches species_catalogue.slug
  collectedAt       DateTime  @map("collected_at")
  collectedBy       String?   @map("collected_by") @db.VarChar(200)
  collectionSite    String?   @map("collection_site") @db.Text
  collectionLat     Float?    @map("collection_lat") @db.DoublePrecision
  collectionLng     Float?    @map("collection_lng") @db.DoublePrecision
  quantityGrams     Float     @map("quantity_grams") @db.DoublePrecision
  remainingGrams    Float     @map("remaining_grams") @db.DoublePrecision
  storageLocation   String?   @map("storage_location") @db.VarChar(200)
  viabilityPercent  Float?    @map("viability_percent") @db.DoublePrecision
  provenanceRef     String?   @map("provenance_ref") @db.VarChar(200)
  status            String    @default("collected") @db.VarChar(20) // collected | stored | distributed | planted | depleted
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  seedBank          SeedBank  @relation(fields: [seedBankId], references: [id], onDelete: Cascade)
  distributions     SeedDistribution[]

  @@index([seedBankId])
  @@index([speciesSlug])
  @@index([status])
  @@index([collectedAt])
  @@map("seed_batches")
}

// ── SeedDistribution ────────────────────────────────────────────────────────
//
// Movement of seed from a seed bank to a nursery and/or planting site
// (Issue #1709). Each row preserves provenance so planted trees can be
// traced back to the originating batch.
model SeedDistribution {
  id                String    @id @default(cuid())
  seedBatchId       String    @map("seed_batch_id")
  destinationType   String    @map("destination_type") @db.VarChar(20) // nursery | planting_site
  destinationName   String    @map("destination_name") @db.VarChar(200)
  plantingLocationId Int?     @map("planting_location_id")
  quantityGrams     Float     @map("quantity_grams") @db.DoublePrecision
  distributedAt     DateTime  @map("distributed_at")
  receivedBy        String?   @map("received_by") @db.VarChar(200)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  seedBatch         SeedBatch @relation(fields: [seedBatchId], references: [id], onDelete: Cascade)

  @@index([seedBatchId])
  @@index([destinationType])
  @@index([plantingLocationId])
  @@index([distributedAt])
  @@map("seed_distributions")
}

// ── Tree ────────────────────────────────────────────────────────────────────
//
// Existing trees table (documented here for the seed provenance link added
// in Issue #1709). Each tree may reference the seed batch it was grown from.
model Tree {
  id              String    @id @default(cuid())
  seedBatchId     String?   @map("seed_batch_id")
  provenanceRef   String?   @map("provenance_ref") @db.VarChar(200)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([seedBatchId])
  @@map("trees")
}
